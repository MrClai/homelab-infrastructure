# Профиль ansible-lint для homelab CI.
# Дефолтный/production-профиль рассчитан на большие команды с зрелым код-ревью
# процессом — на первом прогоне для домашних playbook'ов даст десятки находок
# не по существу. Начинаем с basic осознанно: это рабочий CI-гейт с первого дня,
# а не стена красных ошибок, которую проще выключить, чем разобрать.
#
# Ужесточение до "moderate"/"safety" — отдельная будущая задача (см. roadmap A6),
# не сейчас.

profile: basic

exclude_paths:
  - .cache/
